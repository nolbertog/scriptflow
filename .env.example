# ============================================
# ScriptFlow - Variables de Entorno
# ============================================
# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env
# Luego inicia con: docker compose up --build

# ---- Backend ----
PORT=3001

# Secreto para firmar tokens JWT
# IMPORTANTE: Cambiar en producción por un valor seguro y largo
JWT_SECRET=scriptflow-prod-secret-change-me

# Tiempo de expiración del token JWT (default: 7d)
JWT_EXPIRES_IN=7d

# Origen permitido para CORS en producción (Nginx en puerto 80)
# En desarrollo local usar: http://localhost:5173
CORS_ORIGIN=http://localhost:80
