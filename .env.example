# ScriptFlow - Variables de Entorno

# Puerto del servidor backend (default: 3001)
PORT=3001

# Secreto para firmar tokens JWT
# IMPORTANTE: Cambiar en producción por un valor seguro
JWT_SECRET=scriptflow-dev-secret-change-in-production

# Tiempo de expiración del token JWT (default: 7d)
JWT_EXPIRES_IN=7d

# Origen permitido para CORS (default: http://localhost:5173)
CORS_ORIGIN=http://localhost:5173
