datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  role      String   @default("developer") // admin, developer, viewer, operator
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scripts      Script[]
  folders      Folder[]
  executions   Execution[]
  auditLogs    AuditLog[]
  sessions     Session[]
  cronJobs     CronJob[]
  secrets      Secret[]
  notifications Notification[]
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  ipAddress String?
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Folder {
  id        Int      @id @default(autoincrement())
  name      String
  color     String   @default("#6366f1")
  icon      String   @default("folder")
  parentId  Int?
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Folder?  @relation("FolderToFolder", fields: [parentId], references: [id])
  children Folder[] @relation("FolderToFolder")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scripts  Script[]
}

model Script {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  language    String   @default("bash") // bash, python, javascript, powershell, php, go
  content     String   @default("")
  folderId    Int?
  userId      Int
  isLocked    Boolean  @default(false)
  isProtected Boolean  @default(false)
  isFavorite  Boolean  @default(false)
  tags        String   @default("") // comma-separated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folder   Folder?         @relation(fields: [folderId], references: [id], onDelete: SetNull)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions    ScriptVersion[]
  executions  Execution[]
  cronJobs    CronJob[]
}

model ScriptVersion {
  id        Int      @id @default(autoincrement())
  scriptId  Int
  content   String
  version   Int
  userId    Int
  createdAt DateTime @default(now())

  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)
}

model Execution {
  id         Int      @id @default(autoincrement())
  scriptId   Int
  userId     Int
  status     String   @default("pending") // pending, running, completed, failed, cancelled
  output     String   @default("")
  error      String   @default("")
  duration   Int?     // milliseconds
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())

  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CronJob {
  id          Int      @id @default(autoincrement())
  scriptId    Int
  userId      Int
  expression  String   // cron expression
  description String?
  isActive    Boolean  @default(true)
  timezone    String   @default("UTC")
  retryCount  Int      @default(0)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Secret {
  id        Int      @id @default(autoincrement())
  name      String
  value     String   // encrypted
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String   // create, update, delete, execute, login, etc.
  entity    String   // script, folder, user, cron, secret
  entityId  Int?
  details   String?  // JSON with extra info
  ipAddress String?
  userId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // error, success, warning, info
  title     String
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
